{
  "name": "Prevalida (maqueta de la tesis)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12" }
  },
  "postCreateCommand": "bash .devcontainer/instalar.sh",
  "postAttachCommand": { "servidor": "cd maqueta && python scripts/servidor_demo.py" },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Prevalida", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] },
    "vscode": { "extensions": ["ms-python.python"] }
  }
}
